{
  "id": "zongzi-music",
  "name": "粽子音源",
  "version": "1.1.0",
  "minAppVersion": "0.1.23",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "music.163.com",
      "*.126.net",
      "*.163.com",
      "search.kuwo.cn",
      "antiserver.kuwo.cn",
      "*.kuwo.cn",
      "*.youtube.com",
      "*.ytimg.com",
      "*.googlevideo.com",
      "*.googleapis.com",
      "lrclib.net",
      "github.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "api.bilibili.com",
      "*.bilibili.com",
      "*.bilivideo.com",
      "*.bilivideo.cn",
      "*.mcdn.bilivideo.cn",
      "*.hdslb.com",
      "*.jsdelivr.net",
      "*.qtfm.cn",
      "lhttp.qtfm.cn",
      "stream.zeno.fm",
      "*.zeno.fm",
      "podtown.xyz",
      "*.myqcloud.com",
      "*.fireside.fm",
      "*.xyzfm.space",
      "*.xyzcdn.net",
      "raw.githubusercontent.com",
      "c.y.qq.com",
      "u.y.qq.com",
      "y.qq.com",
      "*.qq.com",
      "*.gtimg.cn",
      "itunes.apple.com",
      "*.apple.com",
      "feed.xyzfm.space",
      "*.xiaoyuzhoufm.com",
      "*.xyzcdn.net",
      "*.ximalaya.com",
      "*.libsyn.com",
      "*.fm",
      "*.simplecast.com",
      "*.megaphone.fm",
      "*.acast.com",
      "*.buzzsprout.com",
      "*.podbean.com",
      "*.typlog.io",
      "*.anchor.fm",
      "icecast.radiofrance.fr",
      "*.radiofrance.fr",
      "ice1.somafm.com",
      "*2.somafm.com",
      "*.somafm.com",
      "stream-relay-geo.ntslive.net",
      "*.ntslive.net",
      "stream.radioparadise.com",
      "*.radioparadise.com",
      "media-ice.musicradio.com",
      "s5-webradio.antenne.de",
      "*.antenne.de"
    ],
    "process": [
      "*",
      "bin/win32-amd64/ffmpeg.exe",
      "bin/win32-arm64/ffmpeg.exe",
      "bin/darwin-arm64/ffmpeg",
      "bin/darwin-x64/ffmpeg",
      "bin/linux-x64/ffmpeg",
      "bin/linux-arm64/ffmpeg",
      "powershell",
      "pwsh",
      "/bin/sh"
    ]
  },
  "settings": [
    {
      "key": "proxySwitch",
      "label": "使用代理",
      "type": "select",
      "help": "默认开启。YouTube 音频、播客等需要代理才能播放；关闭后全部直连，这些内容可能放不了。",
      "options": [
        { "value": "", "label": "开启（默认）" },
        { "value": "off", "label": "关闭（直连）" }
      ]
    },
    {
      "key": "proxyUrl",
      "label": "代理地址",
      "type": "text",
      "help": "留空使用默认 http://127.0.0.1:7890。支持 http:// 或 socks5:// 开头。"
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "builtin": "liked",
      "title": "我喜欢"
    },
    {
      "title": "我的歌单",
      "page": "mylists",
      "icon": "playlist"
    },
    {
      "title": "最近播放",
      "page": "recent",
      "icon": "history"
    },
    {
      "title": "艺人收藏",
      "page": "artists",
      "icon": "account-heart"
    },
    {
      "title": "电台",
      "page": "stations",
      "icon": "radio"
    },
    {
      "title": "播客",
      "page": "shows",
      "icon": "podcast"
    },
    {
      "title": "播客收藏",
      "page": "myshows",
      "icon": "heart"
    }
  ],
  "description": "免费、免登录的多源聚合音源。搜索、歌单、歌手、专辑、电台一站齐活，支持播客订阅收听，冷门曲目也能补齐。"
}
